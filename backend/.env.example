# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/interview_platform

# Auth
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# AI Provider (resume analysis + aptitude question generation)
# Optional: leave blank to run entirely on the built-in dynamic fallback
# generator. When set, resume analysis and question generation are done
# by Groq instead, with the fallback used automatically if a call fails.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
